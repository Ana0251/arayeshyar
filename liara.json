{
    "platform": "django",
    "app": "arayeshyar",
    "port": 8000,
    "python": {
        "version": "3.13"
    },
    "args": [
        "sh",
        "-c",
        "gunicorn config.wsgi:application --bind 0.0.0.0:$PORT --workers 2 --timeout 120"
    ],
    "env": {
        "DJANGO_SETTINGS_MODULE": "config.settings.prod",
        "DJANGO_ENV": "prod",
        "DEBUG": "False"
    }
}